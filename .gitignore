# ==============================================================================
# Local Data, Databases & Runtime Logs
# ==============================================================================
# Local SQLite Session & Audit Databases
*.db
*.db-shm
*.db-wal
/data/ip_sakti.db*
data/ip_sakti.db*

# Runtime Append-Only Logs & Feedback Data
/data/audit_log
/data/audit_log.csv
data/audit_log
data/audit_log.csv
/data/feedback_log.csv
data/feedback_log.csv
*.log

# Qdrant Vector Store & In-Memory BM25 Serialized Cache
/qdrant_data/
qdrant_data/
*.pkl.gz

# Large Corpus PDFs (keep directory structure via .gitkeep)
/data/corpus/*.pdf
/data/corpus/**/*.pdf
!/data/corpus/**/.gitkeep

# Ensure manifest and statutory sidecars are tracked
!data/manifest.csv
!data/sidecars/

