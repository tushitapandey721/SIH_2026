# ==============================================================================
# IP-SAKTI Sahayak — Environment Configuration Template
# ==============================================================================

# Primary High-Speed Legal LLM (Groq)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Zero-Downtime Fallback Legal LLM (Mistral API)
MISTRAL_API_KEY=your_mistral_api_key_here

# Optional: Digital India Bhashini Dhruva NMT API
BHASHINI_ENDPOINT=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_PIPELINE_ID=your_bhashini_pipeline_id_here

# Backend Server Settings
APP_HOST=0.0.0.0
APP_PORT=8000
ENVIRONMENT=development

# Retrieval, Embeddings & Reranking Settings
# Supported Embeddings: BAAI/bge-m3 (default FP16/CUDA)
EMBEDDING_MODEL_NAME=BAAI/bge-m3
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
QDRANT_PATH=./qdrant_data

# SQLite Session Store & Regulatory Audit Log Database Path
DATABASE_PATH=./data/ip_sakti.db
